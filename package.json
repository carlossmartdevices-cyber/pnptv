{
  "name": "pnptv-telegram-bot",
  "version": "1.0.0",
  "description": "Production-ready Telegram bot for PNPtv with subscriptions, live streams, and social features",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:bot": "node test-bot-features.js",
    "test:bot:auto": "node test-bot-automated.js",
    "test:bot:verbose": "node test-bot-automated.js --verbose",
    "test:bot:report": "node test-bot-automated.js --report=html",
    "test:onboarding": "node test-onboarding.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "docs": "jsdoc -c jsdoc.json",
    "docker:build": "docker build -t pnptv-bot .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migration:expiry": "node src/utils/migrations/checkExpiredSubscriptions.js",
    "pm2:setup": "./pm2-deploy.sh setup",
    "pm2:start": "./pm2-deploy.sh start production",
    "pm2:start:dev": "./pm2-deploy.sh start development",
    "pm2:stop": "./pm2-deploy.sh stop",
    "pm2:restart": "./pm2-deploy.sh restart",
    "pm2:reload": "./pm2-deploy.sh reload production",
    "pm2:status": "./pm2-deploy.sh status",
    "pm2:logs": "./pm2-deploy.sh logs",
    "pm2:monitor": "./pm2-deploy.sh monitor",
    "pm2:delete": "./pm2-deploy.sh delete",
    "pm2:save": "./pm2-deploy.sh save",
    "pm2:startup": "./pm2-deploy.sh startup",
    "pm2:update": "./pm2-deploy.sh update"
  },
  "keywords": [
    "telegram",
    "bot",
    "pnptv",
    "subscriptions",
    "payments",
    "live-streaming"
  ],
  "author": "PNPtv Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^7.100.0",
    "@sentry/tracing": "^7.100.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "dotenv-safe": "^9.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "geolib": "^3.3.4",
    "helmet": "^7.1.0",
    "i18next": "^23.7.16",
    "ioredis": "^5.3.2",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "openai": "^4.24.1",
    "sharp": "^0.33.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "telegraf": "^4.15.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

# Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_NAME=PNPtv Bot
BOT_USERNAME=pnptv_bot

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# Sentry
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Payment Gateways
# ePayco
EPAYCO_PUBLIC_KEY=your_epayco_public_key
EPAYCO_PRIVATE_KEY=your_epayco_private_key
EPAYCO_CUSTOMER_ID=your_epayco_customer_id
EPAYCO_TEST_MODE=true
EPAYCO_WEBHOOK_SECRET=your_webhook_secret

# Daimo Pay
DAIMO_API_KEY=your_daimo_api_key
DAIMO_WEBHOOK_SECRET=your_daimo_webhook_secret
DAIMO_NETWORK=testnet

# Zoom SDK (for meetings)
ZOOM_SDK_KEY=your_zoom_sdk_key
ZOOM_SDK_SECRET=your_zoom_sdk_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret

# Daily.co (Alternative for video meetings - no host required)
DAILY_API_KEY=your_daily_api_key
DAILY_DOMAIN=your_domain.daily.co

# OpenAI (for AI chat)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ASSISTANT_ID=your_assistant_id

# Google Maps (for nearby users)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin Configuration
ADMIN_USER_IDS=123456789,987654321
SUPER_ADMIN_ID=123456789

# Radio Streaming (Icecast/Shoutcast)
RADIO_STREAM_URL=http://your-radio-server.com:8000/stream
RADIO_ADMIN_URL=http://your-radio-server.com:8000/admin
RADIO_ADMIN_PASSWORD=your_radio_admin_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here
SESSION_TTL=86400

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# URLs
WEBAPP_URL=https://your-webapp-url.com
TERMS_URL=https://your-webapp-url.com/terms
PRIVACY_URL=https://your-webapp-url.com/privacy
SUPPORT_URL=https://your-webapp-url.com/support

# Features
ENABLE_AI_CHAT=true
ENABLE_RADIO=true
ENABLE_LIVE_STREAMS=true
ENABLE_ZOOM_ROOMS=true
ENABLE_NEARBY_USERS=true
ENABLE_PAYMENTS=true

# Subscription Plans
PLAN_BASIC_PRICE_USD=9.99
PLAN_PREMIUM_PRICE_USD=19.99
PLAN_GOLD_PRICE_USD=29.99
